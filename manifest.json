{
  "manifest_version": 3,
  "name": "Dark New Tab",
  "version": "1.10.0",
  "description": "Тёмная страница новой вкладки с быстрыми ссылками, поиском Яндекса и ChatGPT.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-autosend.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
